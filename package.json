{
  "name": "@quantovainc/qdeclare",
  "version": "0.7.4",
  "description": "Post quantum asset and interest declarations for public officials. Seals registrations, declarations, corrections, acknowledgements and reviews with ML-DSA-65 under FIPS 204 and Quantova time proofs, so an edited, replaced or backdated declaration is detected.",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "qdeclare": "bin/qdeclare.js"
  },
  "scripts": {
    "test": "NODE_OPTIONS=\"--require=$PWD/test/clock.js\" node --test test/*.test.js",
    "lint": "eslint ."
  },
  "files": [
    "index.js",
    "index.d.ts",
    "lib/",
    "bin/",
    "wasm/qdeclare_native.js",
    "wasm/qdeclare_native_bg.wasm",
    "wasm/qdeclare_native.d.ts",
    "LICENSE-APACHE",
    "LICENSE-MIT",
    "NOTICE",
    "AUTHORS"
  ],
  "engines": {
    "node": ">=20"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "dependencies": {
    "@quantovainc/qstamp": "0.6.4"
  },
  "keywords": [
    "post-quantum",
    "quantum-safe",
    "asset-declarations",
    "conflict-of-interest",
    "ethics",
    "anti-corruption",
    "government",
    "ml-dsa",
    "fips-204",
    "quantova"
  ],
  "license": "Apache-2.0 OR MIT",
  "author": "Quantova Inc",
  "homepage": "https://github.com/Quantova/QDeclare",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Quantova/QDeclare.git"
  },
  "bugs": {
    "url": "https://github.com/Quantova/QDeclare/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.1",
    "eslint-plugin-security": "3.0.1",
    "globals": "16.5.0"
  }
}
